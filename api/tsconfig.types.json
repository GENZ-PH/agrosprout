{
  // Emits route types only, so the app can import AppType without Cloudflare runtime types.
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": false, "declaration": true, "emitDeclarationOnly": true, "outDir": "types", "rootDir": "src" },
  "include": ["src", "worker-configuration.d.ts"]
}
