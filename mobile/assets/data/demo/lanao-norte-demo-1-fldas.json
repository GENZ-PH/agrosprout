    {
      "source": "NASA GES DISC, FLDAS_NOAH01_C_GL_M V001 (FLDAS, Noah 3.6.1, forced by MERRA-2 and CHIRPS), variables SoilMoi00_10cm_tavg, SoilMoi10_40cm_tavg, Evap_tavg, Rainf_f_tavg, Qs_tavg, Qsb_tavg",
