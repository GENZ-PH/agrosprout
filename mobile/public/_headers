# Cloudflare Pages headers (copied into dist/ by expo export).
# The service worker and manifest must never be cached, or updates stop reaching users.
/sw.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
  Content-Type: application/manifest+json
/index.html
  Cache-Control: no-cache
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
